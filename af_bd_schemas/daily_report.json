{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "leads_generated": {"type": "integer", "minimum": 0},
    "qualified_leads": {"type": "integer", "minimum": 0},
    "outreach_sent": {"type": "integer", "minimum": 0},
    "meetings_booked": {"type": "integer", "minimum": 0},
    "top_opportunities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "company_name": {"type": "string"},
          "icp_score": {"type": "integer"},
          "reason": {"type": "string"}
        }
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "description": {"type": "string"},
          "severity": {"type": "string", "enum": ["low", "medium", "high"]}
        }
      }
    }
  },
  "required": ["date", "leads_generated", "qualified_leads", "outreach_sent", "meetings_booked", "top_opportunities", "risks"]
}