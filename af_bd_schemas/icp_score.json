{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "company_name": {"type": "string", "minLength": 1},
    "icp_score": {"type": "integer", "minimum": 0, "maximum": 100},
    "score_breakdown": {
      "type": "object",
      "properties": {
        "hiring_urgency": {"type": "integer", "minimum": 0, "maximum": 20},
        "team_size_fit": {"type": "integer", "minimum": 0, "maximum": 20},
        "budget_signals": {"type": "integer", "minimum": 0, "maximum": 20},
        "industry_fit": {"type": "integer", "minimum": 0, "maximum": 20},
        "tech_maturity": {"type": "integer", "minimum": 0, "maximum": 20}
      },
      "required": ["hiring_urgency", "team_size_fit", "budget_signals", "industry_fit", "tech_maturity"]
    },
    "recommended_angle": {"type": "string"},
    "reasoning": {"type": "string"}
  },
  "required": ["company_name", "icp_score", "score_breakdown", "recommended_angle", "reasoning"]
}